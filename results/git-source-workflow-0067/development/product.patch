+			(
+				name.clone(),
+				crate::manifest::Native {
+					path: n
+						.path
+						.clone()
+						.unwrap_or_else(|| "/unused-git-coordinate".into()),
+					package: n.package.clone(),
+					builder: n.builder.clone(),
+					hook: n.hook,
+				},
+			)
+		})
+		.collect();
