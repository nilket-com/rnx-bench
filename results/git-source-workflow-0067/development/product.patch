+	let mut doc: toml::Value = toml::from_str(&manifest).map_err(|e| e.to_string())?;
+	let deps = doc
+		.get_mut("dependencies")
+		.and_then(toml::Value::as_table_mut)
+		.ok_or("missing generated dependencies")?;
