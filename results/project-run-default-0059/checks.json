[
  {
    "name": "tests",
    "command": [
      "cargo",
      "test",
      "--locked",
      "--",
      "--test-threads=1"
    ],
    "exit": 0
  },
  {
    "name": "tests-support",
    "command": [
      "cargo",
      "test",
      "--locked",
      "--features",
      "test-support",
      "--",
      "--test-threads=1"
    ],
    "exit": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "clippy-support",
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "--all-targets",
      "--features",
      "test-support",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "format",
    "command": [
      "cargo",
      "fmt",
      "--",
      "--check"
    ],
    "exit": 0
  },
  {
    "name": "windows",
    "command": [
      "cargo",
      "check",
      "--locked",
      "--target",
      "x86_64-pc-windows-msvc",
      "--all-targets"
    ],
    "exit": 0
  },
  {
    "name": "notices",
    "command": [
      "python3",
      "scripts/notices.py",
      "--check"
    ],
    "exit": 0
  }
]
