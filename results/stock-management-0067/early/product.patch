diff --git a/Cargo.toml b/Cargo.toml
index 3b755ce..5853b7f 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -28,22 +28,26 @@ publish = false
 
 # Deliberately independent of the product workspace and its editor/GUI hosts.
 [workspace]
+exclude = ["tools/project"]
 
 [features]
-default = ["count-allocations"]
+default = ["count-allocations", "stock-management"]
+# Stock command only; generated/embedding applications disable defaults.
+stock-management = ["dep:rnx-project"]
 # Allocation accounting. Without it no ceiling is enforced and no figure is
 # reported; the build says so rather than reporting zero.
 count-allocations = []
 # Only for gates that must inject what cannot be provoked. Off by default, and
 # nothing in an ordinary build reads it: record 0022 explains why the
 # delivery's failure path needs one.
-test-support = []
+test-support = ["rnx-project?/test-support"]
 # Record 0056: caller-owned handler execution, without HTTP server dependencies.
 server-runtime = []
 # Record 0057: explicit versioned source maps for the file runner.
 project-sources = ["dep:serde"]
 
 [dependencies]
+rnx-project = { path = "tools/project", optional = true }
 serde = { version = "1", features = ["derive"], optional = true }
 rune = { version = "=0.14.2", default-features = false, features = ["std"] }
 serde_json = "1.0.149"
