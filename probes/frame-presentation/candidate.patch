+++ b/src/native_preview.rs
@@ -0,0 +1,36 @@
+//! Gate 1 only: context-owned, explicitly registered native presentation.
+use rune::{Any, Hash, Value};
+use std::collections::BTreeMap;
+type Callback = Box<dyn Fn(&Value, &mut Output) -> Result<(), String>>;
+#[derive(Default)]
+pub struct Presenters(BTreeMap<Hash, Callback>);
+pub struct Output { text: String, limit: usize }
+impl Output {
+    pub fn push(&mut self, text: &str) -> Result<(), String> {
+        if text.len() > self.limit.saturating_sub(self.text.len()) { return Err("preview output limit".into()); }
+        self.text.push_str(text); Ok(())
+    }
+}
+impl Presenters {
+    pub fn register<T: Any>(&mut self, callback: impl Fn(&T, &mut Output) -> Result<(), String> + 'static) -> Result<(), String> {
+        let hash = T::HASH;
+        if self.0.contains_key(&hash) { return Err("duplicate native presenter".into()); }
+        self.0.insert(hash, Box::new(move |value, out| callback(&*value.borrow_ref::<T>().map_err(|e| e.to_string())?, out)));
+        Ok(())
+    }
+    pub(crate) fn append(&mut self, other: Self) -> Result<(), String> {
+        for (hash, callback) in other.0 { if self.0.insert(hash, callback).is_some() { return Err("duplicate native presenter".into()); } } Ok(())
+    }
+    pub(crate) fn render(&self, value: &Value, limit: usize) -> Option<Result<String, String>> {
+        let callback = self.0.get(&value.type_hash())?;
+        let mut output = Output { text: String::new(), limit };
+        Some(callback(value, &mut output).map(|()| output.text))
+    }
+}
+pub struct Registration { pub(crate) help: Vec<(String, &'static str)>, pub(crate) presenters: Presenters }
+impl From<Vec<(String, &'static str)>> for Registration {
+    fn from(help: Vec<(String, &'static str)>) -> Self { Self { help, presenters: Presenters::default() } }
+}
+impl Registration {
+    pub fn with_presenters(help: Vec<(String, &'static str)>, presenters: Presenters) -> Self { Self { help, presenters } }
+}
