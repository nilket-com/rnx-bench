      "created_at": "2023-08-21T14:10:40Z",
      "updated_at": "2023-08-21T15:02:13Z",
      "closed_at": "2023-08-21T15:02:11Z",
      "assignee": null,
      "author_association": "COLLABORATOR",
      "issue_field_values": [],
      "type": null,
      "active_lock_reason": null,
      "draft": false,
      "pull_request": {
        "url": "https://api.github.com/repos/rune-rs/rune/pulls/617",
        "html_url": "https://github.com/rune-rs/rune/pull/617",
        "diff_url": "https://github.com/rune-rs/rune/pull/617.diff",
        "patch_url": "https://github.com/rune-rs/rune/pull/617.patch",
        "merged_at": "2023-08-21T15:02:11Z"
      },
      "body": "This avoids necessarily having to allocate a virtual machine when dealing with function objects and calls which involve other units or contexts, we simply just maintain the call stack inside of a single virtual machine that might refer to instruction pointers in differing contexts.\r\n\r\nBenchmarks indicate that relatively simple cross unit/context function have a 20% performance bump (bench `external_functions`) on my machine due to this, most of it would be due to avoiding additional allocations which are needed to set up individual stacks for separate context calls:\r\n\r\n![image](https://github.com/rune-rs/rune/assets/111092/6e89c193-9a21-496a-b422-b355909d04ff)",
