pub fn main(args) {
let input0 = polars::Series::from_iter_option_i64([Some(1)])?.new_from_index(0, 100000000)?;
let input1 = polars::Series::from_iter_option_i64([Some(2)])?.new_from_index(0, 100000000)?;
let expected = polars::Series::from_iter_option_i64([Some(5)])?.new_from_index(0, 100000000)?;
let prep_start = time::monotonic_ms();
let k = polars::column_kernel("pub fn map(x,y) { x * 3 + y }", "map", ["i64", "i64"], "i64")?;
let prep_ms = time::monotonic_ms() - prep_start;
println!("COLUMN_PREP ms={} {}", prep_ms, k.explain());
for call in 0..2 {
println!("COLUMN_ENTER {}", call);
let started = time::monotonic_ms();
let output = k.map([input0, input1])?;
let elapsed_ms = time::monotonic_ms() - started;
assert!(output.equals_missing(expected));
assert_eq!(output.len()?, 100000000);
println!("COLUMN_OK call={} ms={} {}", call, elapsed_ms, k.last_path());
}
Ok(())
}
